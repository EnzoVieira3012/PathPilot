# PathPilot Configuration
# Copie para .env e ajuste

# Database (SQLite)
DB_PATH=C:\Users\<USER>\.pathpilot\pathpilot.db

# Encryption key for sensitive env vars (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FERNET_KEY=

# Defaults
DEFAULT_SCOPE=user
AUTO_BACKUP=true
CONFIRM_DESTRUCTIVE=true

# UI
THEME=default
SHOW_PROGRESS=true
USE_EMOJI=true